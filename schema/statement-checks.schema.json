{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ZeraBooks/check-register-data-spec/schema/statement-checks.schema.json",
  "title": "Checks paid summary from a bank statement",
  "description": "The checks-paid total and count the bank prints on the statement. The validator proves the register's cleared checks add up to it.",
  "type": "object",
  "required": ["account_last4", "period_start", "period_end", "checks_paid_count", "checks_paid_total"],
  "properties": {
    "bank": {"type": "string"},
    "business": {"type": "string"},
    "account_last4": {"type": "string", "pattern": "^[0-9]{4}$"},
    "period_start": {"type": "string", "format": "date"},
    "period_end": {"type": "string", "format": "date"},
    "checks_paid_count": {"type": "integer", "minimum": 0},
    "checks_paid_total": {"type": "string", "pattern": "^[0-9]+\\.[0-9]{2}$"},
    "register_file": {"type": "string"},
    "fictional": {"const": true}
  }
}
